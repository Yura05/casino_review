# systemd-юніт: тримає застосунок запущеним і перезапускає при падінні/ребуті.
# Куди покласти на сервері:  /etc/systemd/system/casino-review.service
# Після змін:  sudo systemctl daemon-reload && sudo systemctl restart casino-review
#
# Припущення (зміни під себе, якщо інші):
#   - користувач/група: casino
#   - код у:            /home/casino/site_revie
#   - venv у:           /home/casino/site_revie/.venv
#   - .env у:           /home/casino/site_revie/.env  (формат KEY=VALUE)

[Unit]
Description=Casino Review (FastAPI / uvicorn)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=casino
Group=casino
WorkingDirectory=/home/casino/site_revie
EnvironmentFile=/home/casino/site_revie/.env
# --proxy-headers: довіряти X-Forwarded-* від nginx (правильна схема https в url_for).
# --forwarded-allow-ips=*: безпечно, бо uvicorn слухає лише 127.0.0.1 (ззовні недоступний).
ExecStart=/home/casino/site_revie/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 2 --proxy-headers --forwarded-allow-ips=*
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
