# Skopiuj ten plik do `.env` i uzupełnij wartości.
# cp .env.example .env   (Linux/Mac)
# Copy-Item .env.example .env   (Windows PowerShell)

# --- Database ---
# Format: postgresql+psycopg2://USER:PASSWORD@HOST:PORT/DB_NAME
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/casino_review

# --- Site ---
SITE_NAME=Casino Review
SITE_URL=http://localhost:8000

# --- Dev ---
DEBUG=true
