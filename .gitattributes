# Нормалізація переносів рядків.
# За замовчуванням Git сам вирішує (text=auto).
* text=auto

# Файли, що ВИКОНУЮТЬСЯ на Linux-сервері, ЗАВЖДИ з LF —
# інакше CRLF з Windows ламає shebang ("bad interpreter: bash^M")
# та systemd/nginx-конфіги.
*.sh        text eol=lf
*.service   text eol=lf
*.conf      text eol=lf
